if [[ $TERM == 'dumb' ]]; then
  return 1
fi

builtin emulate -L zsh ${=${options[xtrace]:#off}:+-o xtrace}
builtin setopt extended_glob warn_create_global typeset_silent

if (( $+commands[eza] )); then
  typeset enable_autocd=0
  typeset -ag eza_params

  eza_params=(
    '--git' '--icons=always' '--group' '--group-directories-first'
    '--time-style=long-iso' '--color-scale=all' '--color=always' '--hyperlink'
  )

  [[ ! -z $_EZA_PARAMS ]] && eza_params=($_EZA_PARAMS)


  # alias ls='if [[ -z $1 ]]; then COLUMNS=$(tput cols) eza $eza_params | batcat --plain; else COLUMNS=$(tput cols) eza $eza_params "$1"; fi'

  ############# CUSTOM functions for ls, l, ll, llm, la, lx, lt, tree #############

  unalias ls 2>/dev/null  # Remove any existing alias for ls, if it exists

  function ls() {
    if [[ $# -eq 0 ]]; then
      # No arguments, list current directory with eza and batcat
      COLUMNS=$(tput cols) eza $eza_params | batcat --plain
    else
      # Argument(s) passed, list the file or directory
      COLUMNS=$(tput cols) eza $eza_params "$@"
    fi
  }

  # Remove existing aliases
  unalias l ll llm la lx lt tree 2>/dev/null

  # Function for `l` alias
  function l() {
    if [[ $# -eq 0 ]]; then
      COLUMNS=$(tput cols) eza --git-ignore $eza_params | batcat --plain
    else
      COLUMNS=$(tput cols) eza --git-ignore $eza_params "$@"
    fi
  }

  # Function for `ll` alias
  function ll() {
    if [[ $# -eq 0 ]]; then
      COLUMNS=$(tput cols) eza --all --header --long $eza_params | batcat --plain
    else
      COLUMNS=$(tput cols) eza --all --header --long $eza_params "$@"
    fi
  }

  # Function for `llm` alias
  function llm() {
    if [[ $# -eq 0 ]]; then
      COLUMNS=$(tput cols) eza --all --header --long --sort=modified $eza_params | batcat --plain
    else
      COLUMNS=$(tput cols) eza --all --header --long --sort=modified $eza_params "$@"
    fi
  }

  # Function for `la` alias
  function la() {
    if [[ $# -eq 0 ]]; then
      COLUMNS=$(tput cols) eza $eza_params -a --color=always | batcat --plain
    else
      COLUMNS=$(tput cols) eza $eza_params -a --color=always "$@"
    fi
  }

  # `lx` function does not expect an argument, so no changes
  alias lx='COLUMNS=$(tput cols) eza -lbhHigUmuSa@ --color=always | batcat --plain'

  # `lt` function for tree view
  alias lt='COLUMNS=$(tput cols) eza --tree $eza_params | batcat --plain'

  # `tree` function for tree view
  alias tree='COLUMNS=$(tput cols) eza --tree $eza_params | batcat --plain'

  ############# END CUSTOM functions for ls, l, ll, llm, la, lx, lt, tree #############



  ############# ALIASES #############

  # alias ls='COLUMNS=$(tput cols) eza $eza_params | batcat --plain'
  # alias l='COLUMNS=$(tput cols) eza --git-ignore $eza_params | batcat --plain'
  # alias ll='COLUMNS=$(tput cols) eza --all --header --long $eza_params | batcat --plain'
  # alias llm='COLUMNS=$(tput cols) eza --all --header --long --sort=modified $eza_params | batcat --plain'
  # alias la='COLUMNS=$(tput cols) eza $eza_params -a --color=always | batcat --plain'
  # alias lx='COLUMNS=$(tput cols) eza -lbhHigUmuSa@ --color=always | batcat --plain'
  # alias lt='COLUMNS=$(tput cols) eza --tree $eza_params | batcat --plain'
  # alias tree='COLUMNS=$(tput cols) eza --tree $eza_params | batcat --plain'

  [[ "$AUTOCD" = <-> ]] && enable_autocd="$AUTOCD"
  if [[ "$enable_autocd" == "1" ]]; then
    # Function for cd auto list directories
    →auto-eza() { command eza $eza_params; }
    [[ $chpwd_functions[(r)→auto-eza] == →auto-eza ]] || chpwd_functions=( →auto-eza $chpwd_functions )
  fi
else
  print "Plugin zhs-eza: 'eza' not found; using plain ls. Install 'eza' and add it to PATH" >&2
  # define harmless fallbacks so the rest of your config doesn’t break
  alias ls='ls --color=auto'
  alias l='ls -CF'
  alias ll='ls -alF'
  alias la='ls -A'
  alias tree='command tree'   # if tree exists; otherwise omit
fi


return 0
