# zsh-eza plugin (clean, modular)
# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et

# Early exits
[[ $TERM == 'dumb' ]] && return 1
(( ! $+commands[eza] )) && { print -u2 "zsh-eza: 'eza' not found."; return 1; }

# Safe zsh emulation for functions/locals
emulate -L zsh

# Options (quiet globals; nice globbing)
setopt extended_glob warn_create_global typeset_silent

# Resolve a pager: prefer batcat, then bat, else none
typeset -g BAT_CMD=""
if (( $+commands[batcat] )); then
  BAT_CMD="batcat"
elif (( $+commands[bat] )); then
  BAT_CMD="bat"
fi

# Base eza parameters (array-safe)
typeset -ga eza_params
eza_params=(
  --git --icons=always --group --group-directories-first
  --time-style=long-iso --color-scale=all --color=always --hyperlink
)

# Allow override via space-separated string in _EZA_PARAMS, if user/exported
# Example: export _EZA_PARAMS="--icons=auto --no-git"
[[ -n ${_EZA_PARAMS:-} ]] && eza_params=(${=_EZA_PARAMS})


# Avoid alias recursion if user had aliases
unalias ls l ll llm la lx lt tree 2>/dev/null || true

# ---- Internals -------------------------------------------------------------

# Core runner (handles width and eza invocation)
_eza() {
  local -a params; params=( "${eza_params[@]}" "$@" )
  COLUMNS=$(tput cols) command eza "${params[@]}"
}

# Pipe to bat if available; else pass-through
_pipe_or_cat() {
  if [[ -n $BAT_CMD ]]; then
    command "$BAT_CMD" --plain
  else
    command cat
  fi
}

# Helper to DRY the “no-args => pretty pager, args => raw” pattern
# usage: _list "<extra flags...>" -- "$@"
_list() {
  local -a extra argv
  # Split at literal -- into extra and argv
  integer i sep=-1
  for (( i=1; i<=$#; ++i )); do
    [[ ${@[i]} == "--" ]] && { sep=$i; break; }
  done
  if (( sep > 0 )); then
    extra=("${@[1,$((sep-1))]}")
    argv=("${@[$((sep+1)),-1]}")
  else
    extra=("$@")
    argv=()
  fi

  if (( $#argv == 0 )); then
    _eza "${extra[@]}" | _pipe_or_cat
  else
    _eza "${extra[@]}" "${argv[@]}"
  fi
}

# ---- Public commands -------------------------------------------------------

# Plain ls: pretty when no args, raw when args
ls()  { _list -- "$@"; }

# Common variants
l()   { _list --git-ignore -- "$@"; }
ll()  { _list --all --header --long -- "$@"; }
llm() { _list --all --header --long --sort=modified -- "$@"; }
la()  { _list -a --color=always -- "$@"; }

# Always tree/extended lists go through pager for readability
lx()  { _eza -lbhHigUmuSa@ --color=always | _pipe_or_cat; }
lt()  { _eza --tree                         | _pipe_or_cat; }
tree(){ _eza --tree                         | _pipe_or_cat; }

# Optional: auto list on cd if AUTOCD=1
#   export AUTOCD=1
if [[ ${AUTOCD:-0} == 1 ]]; then
  autoload -Uz add-zsh-hook
  eza_chpwd() { command eza "${eza_params[@]}"; }
  add-zsh-hook chpwd eza_chpwd
fi

return 0
